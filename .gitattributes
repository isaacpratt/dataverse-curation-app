# Line-ending policy. The index is already byte-clean (LF everywhere, binaries
# unmarked); these rules keep it that way regardless of the editor's working
# tree behavior (core.autocrlf) on each contributor's machine.
* text=auto

# Source and config: LF everywhere, including on Windows.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf
Makefile text eol=lf

# Windows batch/script files: CRLF, as cmd.exe expects.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated lockfile: not for review diffs; GitHub stats it as generated.
uv.lock -diff linguist-generated

# Holds a Dataverse API token: never diffed, never pasted into reviews.
config.json -diff -text

# Binary assets: never normalize.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.webp binary
*.db binary
*.sqlite binary
# Piskel sprite files are opaque editor project files; keep them byte-identical.
*.piskel binary
